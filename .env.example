# =============================================================================
# SuwayomiOCR configuration
# =============================================================================

# Shared secret that SuwayomiGO sends in `X-API-Key` header. Anything you want.
SERVER_API_KEY=suwasuwa

# --- Upstream OCR backend --------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint that accepts `image_url`
# content. Defaults to a local vLLM serving DeepSeek-OCR-2.
#
# Examples:
#   Local vLLM (DeepSeek-OCR-2):
#     OCR_API_BASE_URL=http://127.0.0.1:19260/v1
#     OCR_API_MODEL=deepseek-ai/DeepSeek-OCR-2
#   OpenAI GPT-4o (vision):
#     OCR_API_BASE_URL=https://api.openai.com/v1
#     OCR_API_MODEL=gpt-4o-mini
#     OCR_API_KEY=sk-...
#   Qwen-VL via DashScope (OpenAI-compatible):
#     OCR_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     OCR_API_MODEL=qwen-vl-max
#     OCR_API_KEY=sk-...
OCR_API_BASE_URL=http://127.0.0.1:19260/v1
OCR_API_MODEL=deepseek-ai/DeepSeek-OCR-2
OCR_API_KEY=
OCR_API_TIMEOUT_S=15

# --- Upstream translation backend ------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Leave TRANSLATION_API_KEY
# empty to disable AI translation and fall back to Google Translate only.
#
# Examples:
#   DeepSeek v4-flash (default, cheap, thinking auto-disabled):
#     TRANSLATION_API_BASE_URL=https://api.deepseek.com/v1
#     TRANSLATION_API_MODEL=deepseek-v4-flash
#   OpenAI:
#     TRANSLATION_API_BASE_URL=https://api.openai.com/v1
#     TRANSLATION_API_MODEL=gpt-4o-mini
#   Qwen via DashScope:
#     TRANSLATION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     TRANSLATION_API_MODEL=qwen-plus
#   Doubao via Volcano Ark:
#     TRANSLATION_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#     TRANSLATION_API_MODEL=doubao-pro-32k
TRANSLATION_API_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_API_MODEL=deepseek-v4-flash
TRANSLATION_API_KEY=sk-REPLACE-ME
TRANSLATION_API_TIMEOUT_S=15

# --- Thinking-mode overrides (optional) ------------------------------------
# By default the server sends every known "disable thinking" field at once
# (thinking={type:disabled} for DeepSeek/Doubao/Anthropic, chat_template_kwargs
# for SGLang/vLLM Qwen3, enable_thinking for DashScope Qwen3, reasoning_effort
# for OpenAI o-series). Unknown providers silently ignore unknown fields,
# so the default works everywhere.
#
# Set the env vars below to a JSON object to REPLACE the bundle entirely.
# Examples:
#   OCR_EXTRA_BODY={"thinking": {"type": "disabled"}}
#   TRANSLATION_EXTRA_BODY={"reasoning_effort": "minimal"}
#   TRANSLATION_EXTRA_BODY={}   # send nothing extra (legacy non-thinking model)

# --- Server bind -----------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=12233
